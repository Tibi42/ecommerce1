{% extends 'base.html.twig' %}

{% block title %}Mon Vélo
{% endblock %}

{% block body %}
	<div class="container mt-4">
		{% if myBike %}
			<h1>Mon Vélo :
				{{ myBike.marque }}
				{{ myBike.modele }}</h1>

			<div class="row">
				<div class="col-md-6">
					{% if myBike.imageUrl %}
						<img src="{{ myBike.imageUrl }}" class="img-fluid rounded" alt="{{ myBike.marque }} {{ myBike.modele }}">
					{% endif %}
				</div>
				<div class="col-md-6">
					<ul class="list-unstyled">
						<li>
							<strong>Marque:</strong>
							{{ myBike.marque }}</li>
						<li>
							<strong>Modèle:</strong>
							{{ myBike.modele }}</li>
						<li>
							<strong>Catégorie:</strong>
							{{ myBike.categorie }}</li>
						<li>
							<strong>Taille:</strong>
							{{ myBike.taille }}</li>
						<li>
							<strong>Genre:</strong>
							{{ myBike.genre }}</li>
						<li>
							<strong>Couleur:</strong>
							{{ myBike.couleur }}</li>
						<li>
							<strong>Stock:</strong>
							{{ myBike.stock }}
							unités</li>
					</ul>

					{% if myBike.description %}
						<p class="lead">{{ myBike.description }}</p>
					{% endif %}

					{% if myBike.estEnPromotion %}
						<p class="card-text">
							<span class="text-decoration-line-through text-muted">{{ myBike.prix }}€</span>
							<span class="text-danger fw-bold fs-4">{{ myBike.prixPromotion }}€</span>
							<span class="badge bg-danger">PROMO</span>
						</p>
					{% else %}
						<p class="text-success fw-bold fs-4">{{ myBike.prix }}€</p>
					{% endif %}

					<div class="mt-3">
						<a href="{{ path('app_velo') }}" class="btn btn-secondary">
							Voir tous les vélos
						</a>
						<a href="{{ path('app_velo_show', {id: myBike.id}) }}" class="btn btn-primary">
							Voir détails complets
						</a>
					</div>
				</div>
			</div>
		{% else %}
			<div class="alert alert-warning">
				<h4>Aucun vélo trouvé</h4>
				<p>Exécutez les fixtures :
					<code>php bin/console doctrine:fixtures:load</code>
				</p>
			</div>
		{% endif %}
	</div>
{% endblock %}
