<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}SamKhaser - Boutique Vélo
			{% endblock %}
		</title>

		<!-- Bootstrap CSS -->
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"> {% block stylesheets %}{% endblock %}
		<link rel="stylesheet" href="{{ asset('assets/styles/app.css') }}">
	</head>
	<body>
		<!-- Navigation -->
		{% include 'organisms/navbar.html.twig' %}

		<!-- Contenu principal avec sidebar -->
		<div class="container-fluid">
			<div
				class="row">
				<!-- Barre latérale -->
				{% include 'organisms/sidebar.html.twig' %}

				<!-- Contenu principal -->
				<main class="col-md-9 col-lg-10 main-content"> {% block body %}{% endblock %}
					</main>
				</div>
			</div>

			<!-- Bootstrap JS -->
			<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
			{% block javascripts %}{% endblock %}
		</body>
	</html>
